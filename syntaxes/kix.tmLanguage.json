{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KIX",
  "scopeName": "source.kix",
  "fileTypes": ["kix"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#fstrings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#class-definition" },
    { "include": "#function-definition" },
    { "include": "#function-call" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.kix",
      "match": "//.*$"
    },

    "fstrings": {
      "name": "string.quoted.double.fstring.kix",
      "begin": "f\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.kix" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.kix" }
      },
      "patterns": [
        {
          "name": "meta.embedded.expression.kix",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.kix" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.kix" }
          },
          "patterns": [
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#operators" },
            { "include": "#function-call" },
            { "include": "#builtins" },
            { "include": "#identifiers" }
          ]
        },
        {
          "name": "constant.character.escape.kix",
          "match": "\\\\."
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.kix",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.kix" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.kix" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.kix",
          "match": "\\\\."
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.kix",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.kix",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "constants": {
      "name": "constant.language.kix",
      "match": "\\b(true|false|null|PI)\\b"
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kix",
          "match": "\\b(if|elif|else|while|for|in|return|end|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.kix",
          "match": "\\b(fn|class|import|new)\\b"
        },
        {
          "name": "keyword.operator.logical.kix",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },

    "types": {
      "name": "storage.type.kix",
      "match": "\\b(int|float|bool|str|arr)\\b"
    },

    "class-definition": {
      "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.kix" },
        "2": { "name": "entity.name.type.class.kix" }
      }
    },

    "function-definition": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.kix" },
        "2": { "name": "entity.name.function.kix" }
      }
    },

    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.kix" }
      }
    },

    "builtins": {
      "name": "support.function.builtin.kix",
      "match": "\\b(window|clear|rect|circle|line|triangle|text|flip|fps|get_fps|width|height|key|mouse_x|mouse_y|mouse_btn|print|input|sqrt|pow|floor|ceil|round|abs|min|max|clamp|sin|cos|tan|int|float|str|bool|typeof|range|array|upper|lower|split|join|contains|substr|len|rand|randint|exit|time|delay)(?=\\s*\\()"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.kix",
          "match": "\\+\\=|\\-\\=|\\*\\=|\\/\\=|="
        },
        {
          "name": "keyword.operator.comparison.kix",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arrow.kix",
          "match": "->"
        },
        {
          "name": "keyword.operator.arithmetic.kix",
          "match": "\\+|\\-|\\*|\\/|%"
        }
      ]
    },

    "identifiers": {
      "name": "variable.other.kix",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
